# ABC Realty backend environment example
# Copy this file to backend/.env and fill in your own values.

# Database
# Use SQLite for local development, or replace with your Supabase/Postgres URL.
SQLALCHEMY_DATABASE_URI=sqlite:///realestate.db

# JWT
JWT_SECRET_KEY=change-this-in-production

# AI chatbot
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307
